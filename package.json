{
  "name": "next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/prepare-python.mjs",
    "predev": "node scripts/prepare-python.mjs && npm run kodlab:build",
    "predev:lan": "node scripts/prepare-python.mjs && npm run kodlab:build",
    "dev": "next dev",
    "dev:lan": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "node scripts/prepare-python.mjs && next build",
    "start": "next start",
    "start:lan": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint",
    "test": "tsx --test lib/course/*.test.ts lib/python/*.test.ts lib/curriculum/*.test.ts app/kodlab/*.test.ts lib/student/*.test.ts lib/student/*.test.mjs lib/http/*.test.ts lib/admin/*.test.ts lib/exam/*.test.ts lib/web-lab/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app components lib",
    "prebuild": "npm run kodlab:build",
    "pretest": "npm run kodlab:test",
    "kodlab:build": "npm run build --workspace @oyunlag/kodlab",
    "kodlab:dev": "npm run dev --workspace @oyunlag/kodlab",
    "kodlab:test": "npm run test --workspace @oyunlag/kodlab"
  },
  "dependencies": {
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/view": "6.43.14",
    "@codesandbox/sandpack-client": "2.19.8",
    "@codesandbox/sandpack-react": "2.20.0",
    "@uiw/react-codemirror": "4.25.12",
    "lucide-react": "1.52.0",
    "mongodb": "^7.7.0",
    "next": "16.3.8",
    "pyodide": "0.29.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "daisyui": "^5.7.50",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "26.1.0",
    "prettier": "3.9.9",
    "tailwindcss": "^4",
    "tsx": "4.23.15"
  },
  "workspaces": [
    "apps/kodlab"
  ]
}
